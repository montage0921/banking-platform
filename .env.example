# Savings Insight Chatbot (RAG) - see backend/src/main/resources/application.properties
#
# Copy this file to .env (at the repo root) and fill in real values.
# .env is git-ignored; this example file is committed so the required
# variables are documented for anyone setting up the project.

# Required: get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides - defaults are set in application.properties
# GROQ_MODEL=openai/gpt-oss-120b

# Chatbot's Postgres (pgvector) datasource - matches docker-compose.yml defaults
APP_DB_URL=jdbc:postgresql://localhost:5433/banking_core
APP_DB_USERNAME=banking_chat
APP_DB_PASSWORD=banking_chat

CHATBOT_DB_URL=jdbc:postgresql://localhost:5433/banking_chat
CHATBOT_DB_USERNAME=banking_chat
CHATBOT_DB_PASSWORD=banking_chat

# MCP (Model Context Protocol) client - scaffolding only, no servers configured yet.
# Uncomment and set once a real MCP server is added (see backend/src/main/resources/application.properties)
# MCP_EXAMPLE_SERVER_URL=
